{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__vercel_path=/api/$1"
    },
    {
      "source": "/api",
      "destination": "/api/index.py?__vercel_path=/api"
    },
    {
      "source": "/",
      "destination": "/api/index.py?__vercel_path=/"
    }
  ]
}
